generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Project {
  id            String        @id @default(cuid())
  name          String
  slug          String        @unique
  apiKey        String        @unique
  webhookUrl    String?
  webhookSecret String
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  transactions  Transaction[]
  webhookLogs   WebhookLog[]
}

model PaymentAccount {
  id            String        @id @default(cuid())
  type          String        // BANK_TRANSFER, EWALLET, QRIS
  provider      String        // BCA, MANDIRI, BRI, BNI, DANA, GOPAY, OVO, SHOPEEPAY, SEABANK, QRIS
  accountName   String
  accountNumber String
  qrisContent   String?       // Static EMVCo QRIS string
  instructions  String?       // Petunjuk pembayaran
  isActive      Boolean       @default(true)
  isDefault     Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  transactions  Transaction[]
}

model Transaction {
  id               String          @id // e.g. TRX-20261102-XXXX
  projectId        String
  project          Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  orderId          String          // ID order dari aplikasi pemanggil (Learnify, VPS, dll)
  amount           Int             // Nominal asli (cth: 150000)
  uniqueCode       Int             // Kode unik (cth: 342)
  totalAmount      Int             // Total yang harus ditransfer (cth: 150342)
  paymentMethod    String          // BCA, MANDIRI, DANA, GOPAY, QRIS, etc
  paymentAccountId String?
  paymentAccount   PaymentAccount? @relation(fields: [paymentAccountId], references: [id], onDelete: SetNull)
  status           String          @default("PENDING") // PENDING, SETTLED, EXPIRED, CANCELLED
  customerName     String?
  customerEmail    String?
  customerPhone    String?
  description      String?
  qrisPayload      String?         // Dynamic EMVCo string with CRC-16
  qrisImage        String?         // Data URL base64 image
  expiresAt        DateTime
  settledAt        DateTime?
  matchedMutationId String?
  metadata         String?         // JSON string metadata dari client
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  webhookLogs      WebhookLog[]
}

model BankMutation {
  id              String        @id @default(cuid())
  provider        String        // BCA, MANDIRI, DANA, GOPAY, QRIS
  accountNumber   String?
  type            String        // CR (Kredit / Uang Masuk), DB (Debit / Uang Keluar)
  amount          Int
  description     String
  balance         Int?
  transactionDate DateTime      @default(now())
  isMatched       Boolean       @default(false)
  matchedTxId     String?
  rawPayload      String?
  createdAt       DateTime      @default(now())
}

model WebhookLog {
  id             String       @id @default(cuid())
  projectId      String
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  transactionId  String
  transaction    Transaction  @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  event          String       // payment.settled, payment.expired
  url            String
  payload        String
  responseStatus Int?
  responseBody   String?
  isSuccess      Boolean      @default(false)
  attempts       Int          @default(1)
  createdAt      DateTime     @default(now())
}

